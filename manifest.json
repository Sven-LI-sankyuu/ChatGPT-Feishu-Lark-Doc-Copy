{
  "manifest_version": 3,
  "name": "ChatGPT 飞书富文本复制",
  "short_name": "飞书复制",
  "version": "0.1.3",
  "description": "在 ChatGPT 回复旁提供独立的飞书文档版复制按钮，保留标题、排版、公式和表格。",
  "homepage_url": "https://github.com/Sven-LI-sankyuu/ChatGPT-Feishu-Lark-Doc-Copy",
  "minimum_chrome_version": "102",
  "permissions": [
    "clipboardRead",
    "clipboardWrite"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "css": [
        "src/content.css"
      ],
      "js": [
        "src/converter.js",
        "src/content.js"
      ],
      "run_at": "document_start"
    }
  ]
}
